    {
        "id": "a5a510e3494ea8c2",
        "type": "http in",
        "z": "04147d43cac8c7cd",
        "name": "GET /api/items/:id",
        "url": "/api/items/:id",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 250,
        "y": 460,
        "wires": [
            [
                "fbae1ce5757dfda2"
            ]
        ]
    },
    {
        "id": "fbae1ce5757dfda2",
        "type": "function",
        "z": "04147d43cac8c7cd",
        "name": "items handler",
        "func": "const id = msg.req.params.id;\nconst limit = parseInt(msg.req.query.limit) || 10;\n\n// Проверка на ошибку 400: id должен быть числом\nif (isNaN(id)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"ID must be a number\",\n        code: 400\n    };\n    return [null, msg]; // второй выход — ошибка\n}\n\n// Проверка на ошибку 404: id не должен быть больше 100\nif (parseInt(id) > 100) {\n    msg.statusCode = 404;\n    msg.payload = {\n        status: \"error\",\n        message: \"Item not found\",\n        code: 404\n    };\n    return [null, msg]; // второй выход — ошибка\n}\n\n// Успешный ответ\nmsg.payload = {\n    status: \"success\",\n    itemId: parseInt(id),\n    limit: limit,\n    items: [\n        { id: parseInt(id), name: \"Item \" + id }\n    ]\n};\nreturn [msg, null]; // первый выход — успех",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,

        "jsCode": "// 1. Используем let и const\nlet counter = 0;\nconst myArray = [\"яблоко\", \"банан\", \"апельсин\"];\nconst myObject = {\n  name: \"Студент\",\n  group: \"ТВП\",\n  lab: 4\n};\n\n// 2. Используем цикл for\nfor (let i = 0; i < myArray.length; i++) {\n  counter++;\n  console.log(`Элемент ${i}: ${myArray[i]}`);\n}\n\n// 3. Используем if/else\nlet message = \"\";\nif (counter > 2) {\n  message = \"Массив большой\";\n} else {\n  message = \"Массив маленький\";\n}\n\n// 4. Возвращаем объект с полем payload\nreturn {\n  payload: {\n    count: counter,\n    fruits: myArray,\n    info: myObject,\n    status: message\n  }\n};"
